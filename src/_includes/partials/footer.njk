{%- from "icons.njk" import icon -%}
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <picture>
        <source srcset="/assets/img/logo-gaiaroma.webp" type="image/webp">
        <img src="/assets/img/logo-gaiaroma.png" alt="Gaïaroma" width="520" height="641" loading="lazy">
      </picture>
      <p>{{ site.nom }}, naturopathe et praticienne en santé naturelle à {{ site.adresse.ville }} et en visio.</p>
    </div>

    <div>
      <h2 class="site-footer__title">Le cabinet</h2>
      <address>
        <strong>{{ site.marque }} — {{ site.nom }}</strong><br>
        {{ site.adresse.rue }}<br>
        {{ site.adresse.codePostal }} {{ site.adresse.ville }}
      </address>
      <ul class="site-footer__contact">
        <li><a href="{{ site.telephoneLien }}">{{ icon("phone", "icon icon--sm") }} {{ site.telephone }}</a></li>
        <li><a href="mailto:{{ site.email }}">{{ icon("mail", "icon icon--sm") }} {{ site.email }}</a></li>
        <li><a href="{{ site.instagram }}" target="_blank" rel="noopener me">{{ icon("instagram", "icon icon--sm") }} {{ site.instagramPseudo }}</a></li>
      </ul>
    </div>

    <div>
      <h2 class="site-footer__title">Accompagnements</h2>
      <ul class="site-footer__links">
        <li><a href="/bien-dans-votre-peau">Bien dans votre peau</a></li>
        <li><a href="/bien-dans-votre-tete">Bien dans votre tête</a></li>
        <li><a href="/telipro-technique-de-liberation-profonde">TeLiPro</a></li>
        <li><a href="/la-seance-de-naturopathie">La consultation</a></li>
        <li><a href="/informations-pratiques-cabinet-de-coaching">Tarifs & infos pratiques</a></li>
      </ul>
    </div>

    <div>
      <h2 class="site-footer__title">Le site</h2>
      <ul class="site-footer__links">
        <li><a href="/isabelle-gayet-a-saint-germain-sur-morin-77860">Qui suis-je ?</a></li>
        <li><a href="/temoignages-gaiaroma">Témoignages</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/prendre-rendez-vous-naturopathe">Contact</a></li>
      </ul>
      <a class="btn btn--sun btn--sm site-footer__cta" href="{{ site.rdv }}" target="_blank" rel="noopener">{{ icon("calendar", "icon icon--sm") }} Prendre rendez-vous</a>
    </div>
  </div>

  <div class="container site-footer__notice">
    <p>{{ icon("shield", "icon icon--sm") }} La naturopathie ne relève pas du domaine médical, mais lui est complémentaire : elle ne remplace en aucun cas une consultation médicale, un diagnostic ou un traitement.</p>
  </div>

  <div class="container site-footer__bottom">
    <p>© {{ build.year }} {{ site.marque }} — {{ site.nom }}</p>
    <ul>
      <li><a href="/mentions-legales">Mentions légales</a></li>
      <li><a href="/plan-du-site">Plan du site</a></li>
    </ul>
  </div>
</footer>
